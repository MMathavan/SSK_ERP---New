@model System.Data.DataTable

@{
    var table = Model;
    var rowCount = ViewBag.PreviewRowCount != null ? (int)ViewBag.PreviewRowCount : (table != null ? table.Rows.Count : 0);
    var maxRows = ViewBag.PreviewMaxRows != null ? (int)ViewBag.PreviewMaxRows : 0;
}

<div class="mt-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div style="font-weight:600; color:#495057;">Preview Results</div>
        <div style="font-size:12px; color:#6c757d;">
            @if (maxRows > 0)
            {
                <span>Showing @rowCount row(s) (max @maxRows)</span>
            }
            else
            {
                <span>Showing @rowCount row(s)</span>
            }
        </div>
    </div>

    @if (table == null || table.Columns.Count == 0)
    {
        <div class="alert alert-light border">No data</div>
    }
    else if (table.Rows.Count == 0)
    {
        <div class="alert alert-light border">No records found</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-sm">
                <thead class="table-light">
                    <tr>
                        @foreach (System.Data.DataColumn col in table.Columns)
                        {
                            <th>@col.ColumnName</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (System.Data.DataRow row in table.Rows)
                    {
                        <tr>
                            @foreach (System.Data.DataColumn col in table.Columns)
                            {
                                var value = row[col];
                                string text;
                                if (value == null || value == System.DBNull.Value)
                                {
                                    text = string.Empty;
                                }
                                else if (value is DateTime)
                                {
                                    text = ((DateTime)value).ToString("dd-MM-yyyy");
                                }
                                else
                                {
                                    text = Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture);
                                }
                                <td>@text</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
